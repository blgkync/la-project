<div id="prj-detail-loading" class="animate-pulse space-y-4">
  <div class="h-8 w-64 bg-dark-800 rounded-lg"></div>
  <div class="h-40 bg-dark-800 rounded-2xl"></div>
  <div class="h-60 bg-dark-800 rounded-2xl"></div>
</div>

<div id="prj-detail-content" class="hidden">
  <!-- Back + Actions -->
  <div class="flex items-center justify-between mb-6">
    <a href="/projects" class="flex items-center gap-2 text-sm text-dark-400 hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Projelere Don
    </a>
    <div class="flex gap-2">
      <button id="prj-edit-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 hover:bg-dark-700 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Duzenle
      </button>
      <button id="prj-delete-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500/10 border border-red-500/20 text-xs text-red-400 hover:bg-red-500/20 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Sil
      </button>
    </div>
  </div>

  <!-- Project Header Card -->
  <div id="prj-header-card" class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-6 mb-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span id="detail-prj-code" class="px-3 py-1 rounded-lg text-xs font-mono font-bold"></span>
          <span id="detail-prj-type-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-medium uppercase tracking-wider"></span>
        </div>
        <h1 id="detail-prj-name" class="text-2xl font-bold text-white mb-2"></h1>
        <p id="detail-prj-desc" class="text-sm text-gray-400 max-w-2xl"></p>
      </div>
      <div class="text-right space-y-1">
        <span id="detail-prj-status" class="px-3 py-1 rounded-full text-xs font-medium"></span>
        <div class="text-xs text-dark-400 mt-2">
          <div>PI: <span id="detail-prj-pi" class="text-white font-medium"></span></div>
          <div class="mt-1"><span id="detail-prj-dates" class="text-white font-medium"></span></div>
        </div>
      </div>
    </div>
    <div id="detail-prj-tags" class="flex flex-wrap gap-1.5 mt-4"></div>
  </div>

  <!-- Stats Row -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-4 text-center">
      <p class="text-xs text-dark-400">Deneyler</p>
      <p id="detail-stat-exp" class="text-2xl font-bold text-white mt-1">0</p>
    </div>
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-4 text-center">
      <p class="text-xs text-dark-400">IP Ilerleme</p>
      <p id="detail-stat-wp" class="text-2xl font-bold text-accent-400 mt-1">0%</p>
    </div>
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-4 text-center">
      <p class="text-xs text-dark-400">Butce Kullanimi</p>
      <p id="detail-stat-budget" class="text-2xl font-bold text-white mt-1">0%</p>
    </div>
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-4 text-center">
      <p class="text-xs text-dark-400">Lab Kayitlari</p>
      <p id="detail-stat-entries" class="text-2xl font-bold text-white mt-1">0</p>
    </div>
  </div>

  <!-- Budget Bar -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 mb-6">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-sm font-semibold text-white">Butce Durumu</h3>
      <span id="detail-budget-text" class="text-xs text-dark-400"></span>
    </div>
    <div class="h-3 bg-dark-800 rounded-full overflow-hidden">
      <div id="detail-budget-bar" class="h-full rounded-full transition-all duration-700" style="width:0%"></div>
    </div>
  </div>

  <!-- Experiments + Work Packages -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-white">Deneyler</h3>
        <a href="/experiments" class="text-xs text-accent-400 hover:text-accent-300">Tumu &rarr;</a>
      </div>
      <div id="detail-experiments" class="space-y-2 max-h-80 overflow-y-auto"></div>
    </div>
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-white">Is Paketleri</h3>
        <a href="/workpackages" class="text-xs text-accent-400 hover:text-accent-300">Tumu &rarr;</a>
      </div>
      <div id="detail-workpackages" class="space-y-3 max-h-80 overflow-y-auto"></div>
    </div>
  </div>

  <!-- Recent Entries + Upcoming Events -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <h3 class="text-sm font-semibold text-white mb-4">Son Lab Kayitlari</h3>
      <div id="detail-entries" class="space-y-2 max-h-72 overflow-y-auto"></div>
    </div>
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <h3 class="text-sm font-semibold text-white mb-4">Yaklasan Etkinlikler</h3>
      <div id="detail-events" class="space-y-2 max-h-72 overflow-y-auto"></div>
    </div>
  </div>

  <!-- Attachments Section -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-white">Proje Dosyalari</h3>
      <label class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 hover:bg-dark-700 transition-colors cursor-pointer">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        Dosya Yukle
        <input type="file" id="prj-file-input" multiple class="hidden" onchange="PrjDetailPage.uploadFiles(this.files)">
      </label>
    </div>
    <div id="prj-attachments" class="space-y-3"></div>
  </div>
</div>

<script>const PROJECT_ID = <%= projectId %>;</script>
