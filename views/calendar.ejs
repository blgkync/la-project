<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold text-white">Ajanda</h1>
    <p class="text-sm text-dark-400 mt-1">Lab takvimi ve etkinlik yonetimi</p>
  </div>
  <button onclick="CalPage.showCreateModal()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium shadow-lg shadow-accent-500/20 hover:shadow-accent-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Yeni Etkinlik
  </button>
</div>

<!-- View Tabs + Navigation -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div class="flex items-center gap-2">
    <button onclick="CalPage.prevMonth()" class="p-2 rounded-lg bg-dark-800 border border-dark-700 hover:bg-dark-700 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <h2 id="calendar-title" class="text-lg font-semibold text-white min-w-[180px] text-center"></h2>
    <button onclick="CalPage.nextMonth()" class="p-2 rounded-lg bg-dark-800 border border-dark-700 hover:bg-dark-700 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
    <button onclick="CalPage.goToday()" class="ml-2 px-3 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 hover:bg-dark-700 transition-colors">Bugun</button>
  </div>
  <div class="flex gap-1 bg-dark-800 rounded-lg p-0.5 border border-dark-700">
    <button onclick="CalPage.setView('month')" id="view-month-btn" class="px-3 py-1.5 rounded-md text-xs font-medium transition-colors bg-accent-500/10 text-accent-400">Ay</button>
    <button onclick="CalPage.setView('week')" id="view-week-btn" class="px-3 py-1.5 rounded-md text-xs font-medium transition-colors text-dark-400 hover:text-white">Hafta</button>
    <button onclick="CalPage.setView('day')" id="view-day-btn" class="px-3 py-1.5 rounded-md text-xs font-medium transition-colors text-dark-400 hover:text-white">Gun</button>
  </div>
</div>

<!-- Legend -->
<div class="flex flex-wrap gap-4 mb-4">
  <div class="flex items-center gap-1.5 text-xs text-dark-400"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>Deney</div>
  <div class="flex items-center gap-1.5 text-xs text-dark-400"><span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>Toplanti</div>
  <div class="flex items-center gap-1.5 text-xs text-dark-400"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>Son Tarih</div>
  <div class="flex items-center gap-1.5 text-xs text-dark-400"><span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>Bakim</div>
  <div class="flex items-center gap-1.5 text-xs text-dark-400"><span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>Degerlendirme</div>
</div>

<!-- Calendar Grid -->
<div id="calendar-container" class="rounded-2xl bg-dark-900/80 border border-dark-700/50 overflow-hidden">
  <div class="animate-pulse p-6"><div class="h-96 bg-dark-800 rounded-xl"></div></div>
</div>

<!-- Event Modal -->
<div id="event-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm overflow-y-auto">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-lg mx-4 my-8 transform scale-95 opacity-0 transition-all duration-200" id="event-modal-box">
    <div class="flex items-center justify-between p-5 border-b border-dark-700/50">
      <h3 id="event-modal-title" class="text-lg font-semibold text-white">Yeni Etkinlik</h3>
      <button onclick="CalPage.closeModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <form id="event-form" class="p-5 space-y-4">
      <input type="hidden" id="event-id">
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Proje</label>
        <select id="event-project" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
          <option value="">-- Proje Sec --</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Baslik *</label>
        <input type="text" id="event-title" required class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Aciklama</label>
        <textarea id="event-desc" rows="2" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Tur</label>
        <select id="event-type" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
          <option value="experiment">Deney</option>
          <option value="meeting">Toplanti</option>
          <option value="deadline">Son Tarih</option>
          <option value="maintenance">Bakim</option>
          <option value="review">Degerlendirme</option>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Baslangic *</label>
          <input type="datetime-local" id="event-start" required class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Bitis</label>
          <input type="datetime-local" id="event-end" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium hover:shadow-lg hover:shadow-accent-500/20 transition-all">Kaydet</button>
        <button type="button" onclick="CalPage.closeModal()" class="px-6 py-2.5 rounded-xl bg-dark-800 border border-dark-700 text-gray-300 text-sm hover:bg-dark-700 transition-colors">Iptal</button>
      </div>
    </form>
  </div>
</div>

<!-- Event Detail Modal -->
<div id="event-detail-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-md mx-4 transform scale-95 opacity-0 transition-all duration-200" id="event-detail-modal-box">
    <div class="p-5">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h3 id="event-detail-title" class="text-lg font-semibold text-white"></h3>
          <span id="event-detail-type" class="inline-block mt-1 px-2.5 py-0.5 rounded-full text-xs font-medium"></span>
        </div>
        <button onclick="CalPage.closeDetailModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <p id="event-detail-desc" class="text-sm text-gray-300 mb-4"></p>
      <div class="space-y-2 text-xs text-dark-400 mb-4">
        <div>Baslangic: <span id="event-detail-start" class="text-white font-medium"></span></div>
        <div>Bitis: <span id="event-detail-end" class="text-white font-medium"></span></div>
      </div>
      <div class="flex gap-2">
        <button id="event-detail-edit" class="flex-1 py-2 rounded-xl bg-dark-800 border border-dark-700 text-xs text-gray-300 hover:bg-dark-700 transition-colors">Duzenle</button>
        <button id="event-detail-delete" class="px-4 py-2 rounded-xl bg-red-500/10 border border-red-500/20 text-xs text-red-400 hover:bg-red-500/20 transition-colors">Sil</button>
      </div>
    </div>
  </div>
</div>
