<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-2 mb-2">
      <a href="/formulations" class="text-sm text-dark-400 hover:text-white transition-colors flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Formulasyonlar
      </a>
    </div>
    <h1 class="text-xl font-bold text-white">Formulasyon Karsilastirma</h1>
    <p class="text-sm text-dark-400 mt-1">Birden fazla formulasyonu yan yana kiyaslayin</p>
  </div>
  <div class="flex gap-2">
    <button onclick="CmpPage.showCreateModal()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium shadow-lg shadow-accent-500/20 hover:shadow-accent-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Yeni Karsilastirma
    </button>
  </div>
</div>

<!-- Saved Comparisons -->
<div id="comparisons-list" class="space-y-3 mb-8"></div>

<!-- Active Comparison View -->
<div id="comparison-view" class="hidden">
  <div class="flex items-center justify-between mb-4">
    <h2 id="comparison-title" class="text-lg font-semibold text-white"></h2>
    <div class="flex gap-2">
      <button onclick="CmpPage.addFormulation()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent-500/10 border border-accent-500/20 text-xs text-accent-400 hover:bg-accent-500/20 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Formulasyon Ekle
      </button>
      <button onclick="CmpPage.exportCSV()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 hover:bg-dark-700 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        CSV Indir
      </button>
    </div>
  </div>

  <!-- Comparison Table -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm" id="comparison-table">
        <thead id="comparison-thead"></thead>
        <tbody id="comparison-tbody"></tbody>
        <tfoot id="comparison-tfoot"></tfoot>
      </table>
    </div>
  </div>
</div>

<!-- Create Comparison Modal -->
<div id="cmp-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm overflow-y-auto">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-lg mx-4 my-8 transform scale-95 opacity-0 transition-all duration-200" id="cmp-modal-box">
    <div class="flex items-center justify-between p-5 border-b border-dark-700/50">
      <h3 class="text-lg font-semibold text-white">Yeni Karsilastirma</h3>
      <button onclick="CmpPage.closeCreateModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="p-5 space-y-4">
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Karsilastirma Adi *</label>
        <input type="text" id="cmp-name" required class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Formulasyonlar (birden fazla secin)</label>
        <div id="cmp-formulation-checklist" class="max-h-60 overflow-y-auto space-y-2 p-3 rounded-xl bg-dark-800/50 border border-dark-700/50"></div>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Notlar</label>
        <textarea id="cmp-notes" rows="2" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
      </div>
      <div class="flex gap-3">
        <button onclick="CmpPage.createComparison()" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium hover:shadow-lg hover:shadow-accent-500/20 transition-all">Olustur</button>
        <button onclick="CmpPage.closeCreateModal()" class="px-6 py-2.5 rounded-xl bg-dark-800 border border-dark-700 text-gray-300 text-sm hover:bg-dark-700 transition-colors">Iptal</button>
      </div>
    </div>
  </div>
</div>

<!-- Add Formulation Modal -->
<div id="add-frm-modal" class="fixed inset-0 z-[51] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-md mx-4 transform scale-95 opacity-0 transition-all duration-200" id="add-frm-modal-box">
    <div class="flex items-center justify-between p-5 border-b border-dark-700/50">
      <h3 class="text-lg font-semibold text-white">Formulasyon Ekle</h3>
      <button onclick="CmpPage.closeAddModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="p-5 space-y-4">
      <select id="add-frm-select" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        <option value="">-- Formulasyon Sec --</option>
      </select>
      <div class="flex gap-3">
        <button onclick="CmpPage.executeAddFormulation()" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium">Ekle</button>
        <button onclick="CmpPage.closeAddModal()" class="px-6 py-2.5 rounded-xl bg-dark-800 border border-dark-700 text-gray-300 text-sm hover:bg-dark-700 transition-colors">Iptal</button>
      </div>
    </div>
  </div>
</div>
