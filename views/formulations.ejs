<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold text-white">Formulasyonlar</h1>
    <p class="text-sm text-dark-400 mt-1">Recete ve formulasyonlari olusturun, kiyaslayin ve yonetin</p>
  </div>
  <div class="flex gap-2">
    <a href="/formulations/compare" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 hover:bg-dark-700 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      Karsilastir
    </a>
    <button onclick="FrmPage.showCreateModal()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium shadow-lg shadow-accent-500/20 hover:shadow-accent-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Yeni Formulasyon
    </button>
  </div>
</div>

<!-- Filters -->
<div class="flex flex-wrap gap-3 mb-6">
  <select id="filter-project" onchange="FrmPage.onProjectChange()" class="px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 focus:outline-none focus:border-accent-500/50">
    <option value="">Tum Projeler</option>
  </select>
  <select id="filter-experiment" onchange="FrmPage.load()" class="px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 focus:outline-none focus:border-accent-500/50">
    <option value="">Tum Deneyler</option>
  </select>
  <select id="filter-status" onchange="FrmPage.load()" class="px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 focus:outline-none focus:border-accent-500/50">
    <option value="">Tum Durumlar</option>
    <option value="draft">Taslak</option>
    <option value="prepared">Hazirlandi</option>
    <option value="tested">Test Edildi</option>
    <option value="approved">Onaylandi</option>
    <option value="rejected">Reddedildi</option>
  </select>
  <div class="relative flex-1 min-w-[200px]">
    <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <input type="text" id="filter-search" placeholder="Formulasyon ara..." oninput="FrmPage._debouncedSearch()" class="w-full pl-9 pr-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 placeholder-dark-400 focus:outline-none focus:border-accent-500/50">
  </div>
</div>

<!-- Formulation Cards Grid -->
<div id="formulations-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  <div class="animate-pulse space-y-3 col-span-full">
    <div class="h-36 bg-dark-800 rounded-2xl"></div>
    <div class="h-36 bg-dark-800 rounded-2xl"></div>
  </div>
</div>

<!-- Empty State -->
<div id="formulations-empty" class="hidden text-center py-16">
  <svg class="w-16 h-16 mx-auto text-dark-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
  <h3 class="text-white font-semibold mb-2">Henuz formulasyon yok</h3>
  <p class="text-dark-400 text-sm mb-4">Yeni bir formulasyon olusturarak baslayin</p>
  <button onclick="FrmPage.showCreateModal()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium">Yeni Formulasyon</button>
</div>

<!-- Formulation Builder Modal -->
<div id="frm-modal" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/60 backdrop-blur-sm overflow-y-auto">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-5xl mx-4 my-6 transform scale-95 opacity-0 transition-all duration-200" id="frm-modal-box">
    <!-- Header -->
    <div class="flex items-center justify-between p-5 border-b border-dark-700/50">
      <h3 id="frm-modal-title" class="text-lg font-semibold text-white">Yeni Formulasyon</h3>
      <button onclick="FrmPage.closeModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>

    <form id="frm-form" onsubmit="FrmPage.save(event)" class="max-h-[85vh] overflow-y-auto">
      <input type="hidden" id="frm-id">

      <!-- Top Bar -->
      <div class="p-5 space-y-4 border-b border-dark-700/30">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Ad *</label>
            <input type="text" id="frm-name" required class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
          </div>
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Kod</label>
            <input type="text" id="frm-code" readonly class="w-full px-3 py-2 rounded-xl bg-dark-800/50 border border-dark-700 text-sm text-dark-300 font-mono focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Proje</label>
            <select id="frm-project" onchange="FrmPage.onFormProjectChange()" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
              <option value="">-- Proje Sec --</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Deney</label>
            <select id="frm-experiment" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
              <option value="">-- Deney Sec --</option>
            </select>
          </div>
        </div>

        <!-- Batch Size + Status -->
        <div class="flex flex-wrap items-end gap-4">
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Batch Boyutu</label>
            <div class="flex items-center gap-2">
              <div class="flex rounded-xl overflow-hidden border border-dark-700">
                <button type="button" onclick="FrmPage.setBatchSize(100)" class="batch-btn px-3 py-2 text-xs bg-dark-800 text-gray-300 hover:bg-dark-700 transition-colors border-r border-dark-700" data-size="100">100g</button>
                <button type="button" onclick="FrmPage.setBatchSize(150)" class="batch-btn px-3 py-2 text-xs bg-dark-800 text-gray-300 hover:bg-dark-700 transition-colors border-r border-dark-700" data-size="150">150g</button>
                <button type="button" onclick="FrmPage.setBatchSize(250)" class="batch-btn px-3 py-2 text-xs bg-dark-800 text-gray-300 hover:bg-dark-700 transition-colors border-r border-dark-700" data-size="250">250g</button>
                <button type="button" onclick="FrmPage.setBatchSize(300)" class="batch-btn px-3 py-2 text-xs bg-dark-800 text-gray-300 hover:bg-dark-700 transition-colors border-r border-dark-700" data-size="300">300g</button>
                <button type="button" onclick="FrmPage.setBatchSize(500)" class="batch-btn px-3 py-2 text-xs bg-dark-800 text-gray-300 hover:bg-dark-700 transition-colors" data-size="500">500g</button>
              </div>
              <input type="number" id="frm-batch-size" value="100" min="0.1" step="0.1" onchange="FrmPage.recalcAll()" class="w-24 px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white text-center font-mono focus:outline-none focus:border-accent-500/50">
              <span class="text-xs text-dark-400">g</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Durum</label>
            <select id="frm-status" class="px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
              <option value="draft">Taslak</option>
              <option value="prepared">Hazirlandi</option>
              <option value="tested">Test Edildi</option>
              <option value="approved">Onaylandi</option>
              <option value="rejected">Reddedildi</option>
            </select>
          </div>
        </div>

        <!-- Process Parameters: Mixing & Oven -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4">
          <!-- Karistirici -->
          <div class="p-4 rounded-xl bg-dark-800/40 border border-dark-700/40">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              <h5 class="text-xs font-semibold text-blue-400 uppercase tracking-wider">Karistirici</h5>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Sure (dk)</label>
                <input type="number" id="frm-mixing-duration" min="0" step="1" value="0" class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-sm text-white font-mono focus:outline-none focus:border-blue-500/50">
              </div>
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Hiz</label>
                <input type="text" id="frm-mixing-speed" placeholder="orn: 800 rpm" class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-blue-500/50">
              </div>
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Sicaklik (C)</label>
                <input type="number" id="frm-mixing-temp" min="0" step="0.1" placeholder="25" class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-sm text-white font-mono focus:outline-none focus:border-blue-500/50">
              </div>
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Not</label>
                <input type="text" id="frm-mixing-notes" placeholder="Karistirma notu..." class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 focus:outline-none focus:border-blue-500/50">
              </div>
            </div>
          </div>

          <!-- Etuv -->
          <div class="p-4 rounded-xl bg-dark-800/40 border border-dark-700/40">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/></svg>
              <h5 class="text-xs font-semibold text-orange-400 uppercase tracking-wider">Etuv</h5>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Sure (dk)</label>
                <input type="number" id="frm-oven-duration" min="0" step="1" value="0" class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-sm text-white font-mono focus:outline-none focus:border-orange-500/50">
              </div>
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Sicaklik (C)</label>
                <input type="number" id="frm-oven-temp" min="0" step="0.1" placeholder="80" class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-sm text-white font-mono focus:outline-none focus:border-orange-500/50">
              </div>
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Mod</label>
                <select id="frm-oven-mode" class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-orange-500/50">
                  <option value="">-- Sec --</option>
                  <option value="Normal">Normal</option>
                  <option value="Vakum">Vakum</option>
                  <option value="Inert">Inert (N2)</option>
                  <option value="Konveksiyonlu">Konveksiyonlu</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] text-dark-400 mb-1">Not</label>
                <input type="text" id="frm-oven-notes" placeholder="Etuv notu..." class="w-full px-2.5 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 focus:outline-none focus:border-orange-500/50">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Component Table -->
      <div class="p-5">
        <div class="flex items-center justify-between mb-3">
          <h4 class="text-sm font-semibold text-white">Bilesenler</h4>
          <button type="button" onclick="FrmPage.addItemRow()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent-500/10 border border-accent-500/20 text-xs text-accent-400 hover:bg-accent-500/20 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Malzeme Ekle
          </button>
        </div>

        <div class="rounded-xl border border-dark-700/50 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm" id="frm-items-table">
              <thead>
                <tr class="bg-dark-800/50 border-b border-dark-700/50">
                  <th class="px-3 py-2.5 text-left text-xs font-semibold text-dark-400 w-8">#</th>
                  <th class="px-3 py-2.5 text-left text-xs font-semibold text-dark-400 min-w-[200px]">Malzeme</th>
                  <th class="px-3 py-2.5 text-left text-xs font-semibold text-dark-400 w-28">Kategori</th>
                  <th class="px-3 py-2.5 text-center text-xs font-semibold text-dark-400 w-24">%</th>
                  <th class="px-3 py-2.5 text-center text-xs font-semibold text-dark-400 w-28">Miktar (g)</th>
                  <th class="px-3 py-2.5 text-left text-xs font-semibold text-dark-400 w-32">Notlar</th>
                  <th class="px-3 py-2.5 w-10"></th>
                </tr>
              </thead>
              <tbody id="frm-items-body"></tbody>
            </table>
          </div>
        </div>

        <!-- Summary Bar -->
        <div id="frm-summary" class="mt-4 flex flex-wrap items-center gap-4 p-4 rounded-xl bg-dark-800/50 border border-dark-700/50">
          <div class="flex items-center gap-2">
            <span class="text-xs text-dark-400">Toplam %:</span>
            <span id="frm-total-pct" class="text-lg font-bold font-mono text-green-400">0.0</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs text-dark-400">Kalan %:</span>
            <span id="frm-remaining-pct" class="text-sm font-medium font-mono text-dark-300">100.0</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs text-dark-400">Toplam Agirlik:</span>
            <span id="frm-total-weight" class="text-sm font-medium font-mono text-white">0.00 g</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs text-dark-400">Bilesen Sayisi:</span>
            <span id="frm-item-count" class="text-sm font-medium text-white">0</span>
          </div>
        </div>
      </div>

      <!-- Bottom Section -->
      <div class="p-5 border-t border-dark-700/30 space-y-4">
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Notlar</label>
          <textarea id="frm-notes" rows="2" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Sonuc Notlari</label>
            <textarea id="frm-result-notes" rows="2" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-dark-300 mb-1.5">Degerlendirme</label>
            <div id="frm-rating" class="flex gap-1 mt-1">
              <button type="button" onclick="FrmPage.setRating(1)" class="star-btn text-2xl text-dark-600 hover:text-yellow-400 transition-colors" data-star="1">&#9733;</button>
              <button type="button" onclick="FrmPage.setRating(2)" class="star-btn text-2xl text-dark-600 hover:text-yellow-400 transition-colors" data-star="2">&#9733;</button>
              <button type="button" onclick="FrmPage.setRating(3)" class="star-btn text-2xl text-dark-600 hover:text-yellow-400 transition-colors" data-star="3">&#9733;</button>
              <button type="button" onclick="FrmPage.setRating(4)" class="star-btn text-2xl text-dark-600 hover:text-yellow-400 transition-colors" data-star="4">&#9733;</button>
              <button type="button" onclick="FrmPage.setRating(5)" class="star-btn text-2xl text-dark-600 hover:text-yellow-400 transition-colors" data-star="5">&#9733;</button>
            </div>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Aciklama</label>
          <textarea id="frm-description" rows="2" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium hover:shadow-lg hover:shadow-accent-500/20 transition-all">Kaydet</button>
          <button type="button" onclick="FrmPage.closeModal()" class="px-6 py-2.5 rounded-xl bg-dark-800 border border-dark-700 text-gray-300 text-sm hover:bg-dark-700 transition-colors">Iptal</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Clone Modal -->
<div id="clone-modal" class="fixed inset-0 z-[51] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-md mx-4 transform scale-95 opacity-0 transition-all duration-200" id="clone-modal-box">
    <div class="flex items-center justify-between p-5 border-b border-dark-700/50">
      <h3 class="text-lg font-semibold text-white">Formulasyonu Klonla</h3>
      <button onclick="FrmPage.closeCloneModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="p-5 space-y-4">
      <input type="hidden" id="clone-source-id">
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Yeni Ad</label>
        <input type="text" id="clone-name" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Batch Boyutu (g)</label>
        <input type="number" id="clone-batch-size" value="100" min="0.1" step="0.1" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white font-mono focus:outline-none focus:border-accent-500/50">
      </div>
      <div class="flex gap-3">
        <button onclick="FrmPage.executeClone()" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-purple-600 text-white text-sm font-medium hover:shadow-lg transition-all">Klonla</button>
        <button onclick="FrmPage.closeCloneModal()" class="px-6 py-2.5 rounded-xl bg-dark-800 border border-dark-700 text-gray-300 text-sm hover:bg-dark-700 transition-colors">Iptal</button>
      </div>
    </div>
  </div>
</div>
