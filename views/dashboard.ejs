<!-- Project Cards -->
<div class="mb-6">
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-sm font-semibold text-white">Projeler</h3>
    <a href="/projects" class="text-xs text-accent-400 hover:text-accent-300 transition-colors">Tumu &rarr;</a>
  </div>
  <div id="dashboard-projects" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="animate-pulse h-28 bg-dark-800 rounded-2xl"></div>
    <div class="animate-pulse h-28 bg-dark-800 rounded-2xl"></div>
    <div class="animate-pulse h-28 bg-dark-800 rounded-2xl"></div>
    <div class="animate-pulse h-28 bg-dark-800 rounded-2xl"></div>
  </div>
</div>

<!-- Quick Stats -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="stat-card group relative overflow-hidden rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 hover:border-blue-500/30 transition-all duration-300">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    <div class="relative flex items-start justify-between">
      <div>
        <p class="text-xs text-dark-400 font-medium uppercase tracking-wider">Aktif Deneyler</p>
        <p id="stat-active-exp" class="text-3xl font-bold text-white mt-1">--</p>
        <p class="text-xs text-dark-400 mt-1"><span id="stat-total-exp" class="text-blue-400 font-medium">--</span> toplam</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center">
        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
      </div>
    </div>
  </div>

  <div class="stat-card group relative overflow-hidden rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 hover:border-accent-500/30 transition-all duration-300">
    <div class="absolute inset-0 bg-gradient-to-br from-accent-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    <div class="relative flex items-start justify-between">
      <div>
        <p class="text-xs text-dark-400 font-medium uppercase tracking-wider">IP Ilerleme</p>
        <p id="stat-wp-progress" class="text-3xl font-bold text-white mt-1">--%</p>
        <p class="text-xs text-dark-400 mt-1"><span id="stat-wp-count" class="text-accent-400 font-medium">--</span> is paketi</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-accent-500/10 flex items-center justify-center">
        <svg class="w-5 h-5 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
    </div>
  </div>

  <div class="stat-card group relative overflow-hidden rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 hover:border-purple-500/30 transition-all duration-300">
    <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    <div class="relative flex items-start justify-between">
      <div>
        <p class="text-xs text-dark-400 font-medium uppercase tracking-wider">Bugunun Etkinlikleri</p>
        <p id="stat-today-events" class="text-3xl font-bold text-white mt-1">--</p>
        <p class="text-xs text-dark-400 mt-1">yaklasan: <span id="stat-upcoming" class="text-purple-400 font-medium">--</span></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center">
        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </div>
  </div>

  <div class="stat-card group relative overflow-hidden rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 hover:border-amber-500/30 transition-all duration-300">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    <div class="relative flex items-start justify-between">
      <div>
        <p class="text-xs text-dark-400 font-medium uppercase tracking-wider">Dusuk Stok Uyarisi</p>
        <p id="stat-low-stock" class="text-3xl font-bold text-white mt-1">--</p>
        <p class="text-xs text-dark-400 mt-1">malzeme <span class="text-amber-400 font-medium">kritik</span></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center">
        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
      </div>
    </div>
  </div>
</div>

<!-- Main Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <!-- Work Package Progress -->
  <div class="lg:col-span-2 rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-white">Is Paketleri Ilerleme</h3>
      <a href="/workpackages" class="text-xs text-accent-400 hover:text-accent-300 transition-colors">Tumu &rarr;</a>
    </div>
    <div id="wp-progress-list" class="space-y-4">
      <div class="animate-pulse space-y-4">
        <div class="h-12 bg-dark-800 rounded-xl"></div>
        <div class="h-12 bg-dark-800 rounded-xl"></div>
        <div class="h-12 bg-dark-800 rounded-xl"></div>
      </div>
    </div>
  </div>

  <!-- Today's Schedule -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-white">Yaklasan Etkinlikler</h3>
      <a href="/calendar" class="text-xs text-accent-400 hover:text-accent-300 transition-colors">Ajanda &rarr;</a>
    </div>
    <div id="upcoming-events-list" class="space-y-3">
      <div class="animate-pulse space-y-3">
        <div class="h-16 bg-dark-800 rounded-xl"></div>
        <div class="h-16 bg-dark-800 rounded-xl"></div>
        <div class="h-16 bg-dark-800 rounded-xl"></div>
      </div>
    </div>
  </div>
</div>

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <!-- Experiment Status Chart -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <h3 class="text-sm font-semibold text-white mb-4">Deney Durumlari</h3>
    <div class="h-64 flex items-center justify-center">
      <canvas id="chart-exp-status"></canvas>
    </div>
  </div>

  <!-- Monthly Activity Chart -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <h3 class="text-sm font-semibold text-white mb-4">Aylik Aktivite</h3>
    <div class="h-64">
      <canvas id="chart-monthly"></canvas>
    </div>
  </div>
</div>

<!-- Recent Activity + Alerts -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Recent Lab Entries -->
  <div class="lg:col-span-2 rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-white">Son Lab Kayitlari</h3>
      <a href="/notebook" class="text-xs text-accent-400 hover:text-accent-300 transition-colors">Tumu &rarr;</a>
    </div>
    <div id="recent-entries-list" class="space-y-3">
      <div class="animate-pulse space-y-3">
        <div class="h-20 bg-dark-800 rounded-xl"></div>
        <div class="h-20 bg-dark-800 rounded-xl"></div>
      </div>
    </div>
  </div>

  <!-- Alerts & Maintenance -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <h3 class="text-sm font-semibold text-white mb-4">Uyarilar</h3>
    <div id="alerts-list" class="space-y-3">
      <div class="animate-pulse space-y-3">
        <div class="h-14 bg-dark-800 rounded-xl"></div>
        <div class="h-14 bg-dark-800 rounded-xl"></div>
      </div>
    </div>
  </div>
</div>
