<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-white">Kullanici & Proje Yonetimi</h2>
      <p class="text-sm text-dark-400 mt-1">Kullanici ekleyin, sifre sifirlayin ve proje atamalari yapin</p>
    </div>
    <button onclick="AdminPage.openCreateUserModal()" class="px-4 py-2 rounded-xl bg-accent-600 text-white text-sm font-medium hover:bg-accent-700 transition-colors">
      + Kullanici Ekle
    </button>
  </div>

  <!-- Password Reset Requests -->
  <div id="reset-requests-section" class="hidden">
    <div class="bg-amber-500/5 border border-amber-500/20 rounded-2xl p-5">
      <h3 class="text-sm font-semibold text-amber-400 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        Sifre Sifirlama Talepleri
      </h3>
      <div id="reset-requests-list" class="space-y-2"></div>
    </div>
  </div>

  <div id="admin-loading" class="text-center py-12">
    <div class="inline-flex items-center gap-3 text-dark-400">
      <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      <span>Yukleniyor...</span>
    </div>
  </div>

  <div id="admin-content" class="hidden space-y-4"></div>
</div>

<!-- Create User Modal -->
<div id="create-user-modal" class="fixed inset-0 z-[9998] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl p-6 w-full max-w-md mx-4">
    <h3 class="text-lg font-semibold text-white mb-4">Yeni Kullanici Ekle</h3>
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1">Gorunen Ad</label>
        <input type="text" id="new-user-display" placeholder="Orn: Ahmet Yilmaz" class="w-full px-4 py-3 rounded-xl bg-dark-800/80 border border-dark-700/50 text-sm text-white focus:outline-none focus:border-accent-500/50 transition-all">
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1">Kullanici Adi</label>
        <input type="text" id="new-user-username" placeholder="Orn: ahmet" class="w-full px-4 py-3 rounded-xl bg-dark-800/80 border border-dark-700/50 text-sm text-white focus:outline-none focus:border-accent-500/50 transition-all">
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1">Sifre</label>
        <input type="text" id="new-user-password" placeholder="En az 4 karakter" class="w-full px-4 py-3 rounded-xl bg-dark-800/80 border border-dark-700/50 text-sm text-white focus:outline-none focus:border-accent-500/50 transition-all">
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1">Rol</label>
        <select id="new-user-role" class="w-full px-4 py-3 rounded-xl bg-dark-800/80 border border-dark-700/50 text-sm text-white focus:outline-none focus:border-accent-500/50 transition-all">
          <option value="user">Ekip Uyesi</option>
          <option value="admin">Yonetici</option>
        </select>
      </div>
    </div>
    <div class="flex gap-3 justify-end mt-6">
      <button onclick="AdminPage.closeCreateUserModal()" class="px-4 py-2 rounded-xl bg-dark-800 border border-dark-600 text-gray-300 hover:bg-dark-700 transition-colors">Iptal</button>
      <button onclick="AdminPage.createUser()" class="px-4 py-2 rounded-xl bg-accent-600 text-white hover:bg-accent-700 transition-colors">Olustur</button>
    </div>
  </div>
</div>

<!-- Reset Password Modal -->
<div id="reset-password-modal" class="fixed inset-0 z-[9998] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl p-6 w-full max-w-md mx-4">
    <h3 class="text-lg font-semibold text-white mb-4">Sifre Sifirla</h3>
    <p class="text-sm text-dark-400 mb-3">Kullanici: <span id="reset-user-name" class="text-white font-medium"></span></p>
    <div>
      <label class="block text-xs font-medium text-dark-300 mb-1">Yeni Sifre</label>
      <input type="text" id="reset-new-password" placeholder="Yeni sifre girin" class="w-full px-4 py-3 rounded-xl bg-dark-800/80 border border-dark-700/50 text-sm text-white focus:outline-none focus:border-accent-500/50 transition-all">
    </div>
    <div class="flex gap-3 justify-end mt-6">
      <button onclick="AdminPage.closeResetModal()" class="px-4 py-2 rounded-xl bg-dark-800 border border-dark-600 text-gray-300 hover:bg-dark-700 transition-colors">Iptal</button>
      <button onclick="AdminPage.resetPassword()" class="px-4 py-2 rounded-xl bg-amber-600 text-white hover:bg-amber-700 transition-colors">Sifreyi Sifirla</button>
    </div>
  </div>
</div>

<!-- Assign Project Modal -->
<div id="assign-modal" class="fixed inset-0 z-[9998] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl p-6 w-full max-w-md mx-4">
    <h3 class="text-lg font-semibold text-white mb-4">Proje Ata</h3>
    <p class="text-sm text-dark-400 mb-3">Kullanici: <span id="assign-user-name" class="text-white font-medium"></span></p>
    <select id="assign-project-select" class="w-full px-4 py-3 rounded-xl bg-dark-800/80 border border-dark-700/50 text-sm text-white focus:outline-none focus:border-accent-500/50 transition-all">
      <option value="">Proje secin...</option>
    </select>
    <div class="flex gap-3 justify-end mt-6">
      <button onclick="AdminPage.closeAssignModal()" class="px-4 py-2 rounded-xl bg-dark-800 border border-dark-600 text-gray-300 hover:bg-dark-700 transition-colors">Iptal</button>
      <button onclick="AdminPage.assignProject()" class="px-4 py-2 rounded-xl bg-accent-600 text-white hover:bg-accent-700 transition-colors">Ata</button>
    </div>
  </div>
</div>
