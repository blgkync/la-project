<div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
  <div class="text-6xl font-bold text-red-500/40 mb-4"><%= typeof error !== 'undefined' ? error.statusCode : 500 %></div>
  <h2 class="text-2xl font-semibold text-white mb-2">Bir Hata Olustu</h2>
  <p class="text-dark-400 mb-6"><%= typeof error !== 'undefined' ? error.message : 'Beklenmeyen bir hata olustu' %></p>
  <a href="/" class="px-6 py-2.5 rounded-xl bg-accent-600 text-white font-medium hover:bg-accent-700 transition-colors">Ana Sayfaya Don</a>
</div>
