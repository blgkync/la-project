<header class="fixed top-0 right-0 left-64 z-30 h-14 bg-dark-950/80 backdrop-blur-xl border-b border-dark-700/50 flex items-center justify-between px-6 transition-all duration-300">
  <div class="flex items-center gap-4">
    <button id="sidebar-toggle" class="lg:hidden p-2 rounded-lg hover:bg-dark-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <h2 class="text-sm font-semibold text-white"><%= title %></h2>
    <span id="header-project-badge" class="hidden px-2.5 py-0.5 rounded-full text-[10px] font-medium border"></span>
  </div>

  <div class="flex items-center gap-3">
    <!-- Search -->
    <div class="relative hidden sm:block">
      <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input type="text" id="global-search" placeholder="Ara..." class="w-48 pl-9 pr-3 py-1.5 rounded-lg bg-dark-800/60 border border-dark-700/50 text-xs text-gray-300 placeholder-dark-400 focus:outline-none focus:border-accent-500/50 focus:ring-1 focus:ring-accent-500/20 transition-all">
    </div>

    <!-- Current date -->
    <div class="text-xs text-dark-400 hidden md:block font-mono" id="header-date"></div>

    <!-- Notifications -->
    <button id="notif-btn" class="relative p-2 rounded-lg hover:bg-dark-800 transition-colors group">
      <svg class="w-5 h-5 text-dark-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      <span id="notif-badge" class="absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-red-500 text-[9px] text-white flex items-center justify-center font-bold hidden">0</span>
    </button>
  </div>
</header>

<script>
  document.getElementById('header-date').textContent = new Date().toLocaleDateString('tr-TR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
</script>
