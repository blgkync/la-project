<aside id="sidebar" class="fixed left-0 top-0 bottom-0 w-64 bg-dark-900/95 backdrop-blur-xl border-r border-dark-700/50 z-40 flex flex-col transition-all duration-300 overflow-hidden">
  <!-- Logo -->
  <div class="p-5 border-b border-dark-700/50">
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-accent-500 to-teal-400 flex items-center justify-center shadow-lg shadow-accent-500/20 group-hover:shadow-accent-500/40 transition-shadow">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
      </div>
      <div>
        <h1 class="text-lg font-bold text-white tracking-tight">LA Project</h1>
        <p class="text-[10px] text-accent-400 font-medium uppercase tracking-widest">ArGe Lab Yonetimi</p>
      </div>
    </a>
  </div>

  <!-- Project Context -->
  <div id="sidebar-project-context" class="px-3 pt-3">
    <select id="global-project-filter" onchange="LA.setGlobalProject(this.value)" class="w-full px-3 py-2 rounded-xl bg-dark-800/80 border border-dark-700/50 text-xs text-gray-300 focus:outline-none focus:border-accent-500/50 transition-colors">
      <option value="">Tum Projeler</option>
    </select>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 py-4 px-3 space-y-1 overflow-y-auto">
    <p class="px-3 mb-2 text-[10px] font-semibold text-dark-400 uppercase tracking-widest">Ana Menu</p>

    <a href="/" class="nav-link group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= currentPath === '/' ? 'bg-accent-500/10 text-accent-400 border border-accent-500/20' : 'text-dark-300 hover:text-white hover:bg-dark-800/60' %>">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
      <span>Gosterge Paneli</span>
