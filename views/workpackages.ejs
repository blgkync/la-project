<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold text-white">Is Paketleri</h1>
    <p class="text-sm text-dark-400 mt-1">TUBITAK is paketi yonetimi ve takibi</p>
  </div>
  <button onclick="WPPage.showCreateModal()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium shadow-lg shadow-accent-500/20 hover:shadow-accent-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Yeni Is Paketi
  </button>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-4 text-center">
    <p class="text-xs text-dark-400 uppercase tracking-wider">Toplam Butce</p>
    <p id="wp-total-budget" class="text-2xl font-bold text-white mt-1">--</p>
  </div>
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-4 text-center">
    <p class="text-xs text-dark-400 uppercase tracking-wider">Genel Ilerleme</p>
    <p id="wp-overall-progress" class="text-2xl font-bold text-accent-400 mt-1">--%</p>
  </div>
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-4 text-center">
    <p class="text-xs text-dark-400 uppercase tracking-wider">Toplam IP</p>
    <p id="wp-total-count" class="text-2xl font-bold text-white mt-1">--</p>
  </div>
</div>

<!-- Gantt Timeline -->
<div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 mb-6">
  <h3 class="text-sm font-semibold text-white mb-4">Zaman Cizelgesi</h3>
  <div id="gantt-container" class="overflow-x-auto">
    <div class="animate-pulse h-40 bg-dark-800 rounded-xl"></div>
  </div>
</div>

<!-- WP Cards -->
<div id="wp-list" class="space-y-4">
  <div class="animate-pulse space-y-4">
    <div class="h-48 bg-dark-800 rounded-2xl"></div>
    <div class="h-48 bg-dark-800 rounded-2xl"></div>
  </div>
</div>

<!-- WP Modal -->
<div id="wp-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm overflow-y-auto">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-2xl mx-4 my-8 transform scale-95 opacity-0 transition-all duration-200" id="wp-modal-box">
    <div class="flex items-center justify-between p-5 border-b border-dark-700/50">
      <h3 id="wp-modal-title" class="text-lg font-semibold text-white">Yeni Is Paketi</h3>
      <button onclick="WPPage.closeModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <form id="wp-form" class="p-5 space-y-4 max-h-[70vh] overflow-y-auto">
      <input type="hidden" id="wp-id">
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Proje</label>
        <select id="wp-project" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
          <option value="">-- Proje Sec --</option>
        </select>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Numara *</label>
          <input type="text" id="wp-number" required placeholder="IP-5" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Baslik *</label>
          <input type="text" id="wp-title" required class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Aciklama</label>
        <textarea id="wp-description" rows="2" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Baslangic Tarihi</label>
          <input type="date" id="wp-start" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Bitis Tarihi</label>
          <input type="date" id="wp-end" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Ilerleme (%)</label>
          <input type="number" id="wp-progress" min="0" max="100" value="0" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Butce (TL)</label>
          <input type="number" id="wp-budget" min="0" step="1000" value="0" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
        </div>
        <div>
          <label class="block text-xs font-medium text-dark-300 mb-1.5">Durum</label>
          <select id="wp-status" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
            <option value="planned">Planli</option>
            <option value="in_progress">Devam Ediyor</option>
            <option value="completed">Tamamlandi</option>
            <option value="delayed">Gecikmeli</option>
            <option value="cancelled">Iptal</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Teslim Edilecekler (her satira bir tane)</label>
        <textarea id="wp-deliverables" rows="3" placeholder="Literatur raporu&#10;Patent haritasi&#10;Test raporu" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white placeholder-dark-500 focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium hover:shadow-lg hover:shadow-accent-500/20 transition-all">Kaydet</button>
        <button type="button" onclick="WPPage.closeModal()" class="px-6 py-2.5 rounded-xl bg-dark-800 border border-dark-700 text-gray-300 text-sm hover:bg-dark-700 transition-colors">Iptal</button>
      </div>
    </form>
  </div>
</div>
