<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold text-white">Lab Gunlugu</h1>
    <p class="text-sm text-dark-400 mt-1">Kronolojik lab kayitlari ve gozlemler</p>
  </div>
  <button onclick="NBPage.showCreateModal()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium shadow-lg shadow-accent-500/20 hover:shadow-accent-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Yeni Kayit
  </button>
</div>

<!-- Filters -->
<div class="flex flex-wrap gap-3 mb-6">
  <select id="nb-filter-category" class="px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 focus:outline-none focus:border-accent-500/50">
    <option value="">Tum Kategoriler</option>
    <option value="observation">Gozlem</option>
    <option value="measurement">Olcum</option>
    <option value="note">Not</option>
    <option value="issue">Sorun</option>
    <option value="idea">Fikir</option>
  </select>
  <select id="nb-filter-author" class="px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 focus:outline-none focus:border-accent-500/50">
    <option value="">Tum Yazarlar</option>
  </select>
  <div class="relative flex-1 min-w-[200px]">
    <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <input type="text" id="nb-filter-search" placeholder="Kayit ara..." class="w-full pl-9 pr-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-gray-300 placeholder-dark-400 focus:outline-none focus:border-accent-500/50">
  </div>
</div>

<!-- Timeline -->
<div id="notebook-timeline" class="relative">
  <div class="absolute left-[19px] top-0 bottom-0 w-px bg-dark-700/50"></div>
  <div class="space-y-4">
    <div class="animate-pulse space-y-4">
      <div class="h-28 bg-dark-800 rounded-2xl ml-10"></div>
      <div class="h-28 bg-dark-800 rounded-2xl ml-10"></div>
      <div class="h-28 bg-dark-800 rounded-2xl ml-10"></div>
    </div>
  </div>
</div>

<!-- Entry Modal -->
<div id="nb-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm overflow-y-auto">
  <div class="bg-dark-900 border border-dark-700 rounded-2xl shadow-2xl w-full max-w-lg mx-4 my-8 transform scale-95 opacity-0 transition-all duration-200" id="nb-modal-box">
    <div class="flex items-center justify-between p-5 border-b border-dark-700/50">
      <h3 id="nb-modal-title" class="text-lg font-semibold text-white">Yeni Kayit</h3>
      <button onclick="NBPage.closeModal()" class="p-1.5 rounded-lg hover:bg-dark-800 transition-colors"><svg class="w-5 h-5 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <form id="nb-form" class="p-5 space-y-4">
      <input type="hidden" id="nb-id">
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Proje</label>
        <select id="nb-project" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
          <option value="">-- Proje Sec --</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Yazar *</label>
        <input type="text" id="nb-author" required class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Kategori</label>
        <select id="nb-category" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
          <option value="note">Not</option>
          <option value="observation">Gozlem</option>
          <option value="measurement">Olcum</option>
          <option value="issue">Sorun</option>
          <option value="idea">Fikir</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Icerik *</label>
        <textarea id="nb-content" rows="5" required class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50 resize-none"></textarea>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Ilgili Deney</label>
        <select id="nb-experiment" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white focus:outline-none focus:border-accent-500/50">
          <option value="">-- Yok --</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark-300 mb-1.5">Etiketler (virgul ile)</label>
        <input type="text" id="nb-tags" class="w-full px-3 py-2 rounded-xl bg-dark-800 border border-dark-700 text-sm text-white placeholder-dark-500 focus:outline-none focus:border-accent-500/50">
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-accent-600 to-teal-500 text-white text-sm font-medium hover:shadow-lg hover:shadow-accent-500/20 transition-all">Kaydet</button>
        <button type="button" onclick="NBPage.closeModal()" class="px-6 py-2.5 rounded-xl bg-dark-800 border border-dark-700 text-gray-300 text-sm hover:bg-dark-700 transition-colors">Iptal</button>
      </div>
    </form>
  </div>
</div>
