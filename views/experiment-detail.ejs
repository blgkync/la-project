<div id="exp-detail-loading" class="animate-pulse space-y-4">
  <div class="h-8 w-64 bg-dark-800 rounded-lg"></div>
  <div class="h-40 bg-dark-800 rounded-2xl"></div>
  <div class="h-60 bg-dark-800 rounded-2xl"></div>
</div>

<div id="exp-detail-content" class="hidden">
  <!-- Back + Actions -->
  <div class="flex items-center justify-between mb-6">
    <a href="/experiments" class="flex items-center gap-2 text-sm text-dark-400 hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Deneylere Don
    </a>
    <div class="flex gap-2">
      <button id="exp-edit-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 hover:bg-dark-700 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Duzenle
      </button>
      <button id="exp-delete-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500/10 border border-red-500/20 text-xs text-red-400 hover:bg-red-500/20 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Sil
      </button>
    </div>
  </div>

  <!-- Title + Status -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-6 mb-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div id="detail-project-badge" class="mb-2"></div>
        <h1 id="detail-title" class="text-2xl font-bold text-white mb-2"></h1>
        <div class="flex flex-wrap items-center gap-2">
          <span id="detail-status" class="px-3 py-1 rounded-full text-xs font-medium"></span>
          <span id="detail-priority" class="px-3 py-1 rounded-full text-xs font-medium"></span>
          <span id="detail-researcher" class="text-xs text-dark-400"></span>
        </div>
      </div>
      <div class="text-right text-xs text-dark-400">
        <div>Baslangic: <span id="detail-start" class="text-white font-medium"></span></div>
        <div class="mt-1">Bitis: <span id="detail-end" class="text-white font-medium"></span></div>
      </div>
    </div>
    <div id="detail-tags" class="flex flex-wrap gap-1.5 mt-4"></div>
  </div>

  <!-- Info Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        Hipotez
      </h3>
      <p id="detail-hypothesis" class="text-sm text-gray-300 leading-relaxed"></p>
    </div>
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
        Metodoloji
      </h3>
      <p id="detail-methodology" class="text-sm text-gray-300 leading-relaxed"></p>
    </div>
  </div>

  <!-- Parameters -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 mb-6">
    <h3 class="text-sm font-semibold text-white mb-3">Parametreler</h3>
    <div id="detail-parameters" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
  </div>

  <!-- Results + Observations -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Sonuclar
      </h3>
      <p id="detail-results" class="text-sm text-gray-300 leading-relaxed"></p>
    </div>
    <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
      <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        Gozlemler
      </h3>
      <p id="detail-observations" class="text-sm text-gray-300 leading-relaxed"></p>
    </div>
  </div>

  <!-- Formulations Section -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-white flex items-center gap-2">
        <svg class="w-4 h-4 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
        Formulasyonlar
      </h3>
      <a href="/formulations" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent-500/10 border border-accent-500/20 text-xs text-accent-400 hover:bg-accent-500/20 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Formulasyon Ekle
      </a>
    </div>
    <div id="exp-formulations" class="space-y-2">
      <div class="text-xs text-dark-400">Yukleniyor...</div>
    </div>
  </div>

  <!-- Attachments Section -->
  <div class="rounded-2xl bg-dark-900/80 border border-dark-700/50 p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-white">Dosyalar & Resimler</h3>
      <label class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-800 border border-dark-700 text-xs text-gray-300 hover:bg-dark-700 transition-colors cursor-pointer">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        Dosya Yukle
        <input type="file" id="exp-file-input" multiple class="hidden" onchange="ExpDetailPage.uploadFiles(this.files)">
      </label>
    </div>
    <div id="exp-attachments" class="space-y-3"></div>
  </div>
</div>

<script>const EXPERIMENT_ID = <%= experimentId %>;</script>
